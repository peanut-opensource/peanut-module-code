; Peanut Module Code backend configuration. Copy to server/.env with mode 0600.
; Native PHP reads it, for example from server/: php think run --host 127.0.0.1 --port 20180.
; The managed installer/configuration publisher can also write the instance settings.
; ThinkPHP loads this file natively; config/*.php reads env values with defaults.
; A named sibling server/.env.<name> can be selected with PHP_ENV_NAME=<name>.
; Runtime environment defaults to production. Use development for local-only features.
APP_ENV=production
; Optional SQL/runtime debugging; leave false outside private development.
APP_DEBUG=false
; Required connection to this APP’s actual database. Use the project’s registered host,
; port, schema, account and credential reference. For bundled MySQL the host is its service name.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
; Optional table prefix; retain the prefix for an existing installation.
DB_PREFIX=pa_

; JWT signing secret, required. Use the instance’s existing value or generate
; an independent random secret on fresh setup (for example openssl rand -hex 32).
JWT_SECRET=
; JWT lifetime in seconds, default 7200.
JWT_EXPIRE=7200
; Optional authentication overrides; omit to use config/admin_auth.php defaults.
; ADMIN_LOGIN_LOCK_MINUTES=30
ADMIN_PASSWORD_ERROR_TIMES=5
; Optional verification limits per challenge and per entry, then entry-window seconds.
NOTIFICATION_VERIFICATION_MAX_FAILURES=5
NOTIFICATION_VERIFICATION_ENTRY_MAX_FAILURES=10
NOTIFICATION_VERIFICATION_ENTRY_WINDOW_SECONDS=300
; Retain the instance key for encrypted storage credentials. Use managed credential
; setup for a new key; changing a key requires the native rotation flow.
PEANUT_STORAGE_CREDENTIAL_MASTER_KEY=
; Settings encryption keyring and selected active key ID. Keep the original configured
; keyring with encrypted data; use the instance credential source or managed setup.
PEANUT_SETTINGS_SECRET_KEYS=
PEANUT_SETTINGS_ACTIVE_SECRET_KEY_ID=
; Independent HMAC keys for tenant and platform identifiers. Preserve the instance keys
; for an existing installation; generate independent random values for fresh setup.
TENANT_IDENTIFIER_HMAC_KEY=
PLATFORM_IDENTIFIER_HMAC_KEY=

; Required deployment mode. Use exactly standalone or multi-tenant.
DEPLOYMENT_MODE=multi-tenant
; Optional owner invitation delivery policy; auto uses the configured delivery capability.
OWNER_INVITATION_DELIVERY_MODE=auto

; Fresh installation transport. For automatic mode, write initial identities
; to a separate permission-0600 file and select it with
; PEANUT_INSTALLATION_ENV_FILE for the installer command only. Guided mode
; receives identities in the authenticated setup request.
PEANUT_INSTALLATION_MODE=automatic
; Optional source-only mode; leave blank for ordinary instances.
PEANUT_INSTALLATION_SOURCE_MODE=
; Guided setup token, normally populated by the native installation/runtime entry.
PEANUT_INSTALLATION_SETUP_TOKEN=
; Optional initial module selection for first installation. Blank uses the native selection.
PEANUT_INSTALLATION_OFFICIAL_MODULES=

; Required Platform entry hosts for multi-tenant deployments.
; Tenant Admin/member hosts, including default, use active database bindings.
PLATFORM_HOSTS=

; Optional backend/module runtime settings. These are native ThinkPHP env keys.
; Optional database overrides; omit to use config/database.php defaults.
; DB_DRIVER=mysql
; DB_TYPE=mysql
; DB_CHARSET=utf8mb4
; DB_CONNECT_TIMEOUT_SECONDS=5
; Optional until signed async work is enabled. Reuse the instance key, or generate
; a separate random key for a new instance and share it only with its authorized worker.
ASYNC_SIGNING_KEY=
; Optional worker batch limit; config/async.php defaults to 25.
; ASYNC_WORKER_LIMIT=25
; Optional default locale, version override, and comma-separated extra module roots.
DEFAULT_LANG=zh-cn
PROJECT_VERSION=
PEANUT_MODULE_ROOTS=
; Leave unset to use the layout-aware default in config/modules.php:
; application source: ../modules.lock; backend runtime projection: modules.lock.
; PEANUT_MODULE_LOCK=../modules.lock
; PEANUT_MODULE_KERNEL_VERSION=1.0.0
; Optional trusted public key map for module package policies; empty map by default.
PEANUT_MODULE_TRUSTED_KEYS_JSON={}
; Collaboration is disabled by default.
COLLABORATION_ENABLED=disabled
; Optional profile: publish with configure-collaboration.py enable.
; Application instance, service identity, and selected service key ID from the publisher.
COLLABORATION_INSTANCE_ID=
COLLABORATION_SERVICE_INSTANCE_ID=
COLLABORATION_SERVICE_KEY_ID=
; Service-to-service HMAC key string, at least 32 bytes; never a user token.
; Keep the real backend .env at 0600 and do not commit or log the key.
COLLABORATION_SECRET=
; Backend-facing control origin from the same configuration publisher.
COLLABORATION_CONTROL_ORIGIN=
; Derived by the same managed configuration owner; never a private control URL.
; HTTP/WS is allowed only in APP_ENV=development; other environments require
; HTTPS/WSS. Configure the CA file and its SHA-256 for TLS transports.
COLLABORATION_PUBLIC_WSS_URL=
; Optional private CA file reference and its publisher-verified SHA-256.
COLLABORATION_CA_FILE=
COLLABORATION_CA_SHA256=

; Optional synthetic demo settings. Production deployments normally keep the
; mode disabled and leave the remaining fields empty.
PEANUT_DEMO_MODE=disabled
; Optional synthetic sign-in identities for Admin, Platform and two demo tenants.
PEANUT_DEMO_ADMIN_EMAIL=
PEANUT_DEMO_PLATFORM_EMAIL=
PEANUT_DEMO_TENANT_A_EMAIL=
PEANUT_DEMO_TENANT_B_EMAIL=
; Optional demo account password; use the demo instance credential source.
PEANUT_DEMO_SHARED_PASSWORD=
; Optional demo tenant entry hosts and documentation URL.
PEANUT_DEMO_TENANT_A_HOST=
PEANUT_DEMO_TENANT_B_HOST=
PEANUT_DEMO_DOCS_URL=
; Optional integration machine scope list.
INTEGRATION_MACHINE_SCOPES=
; Required for signed integration webhooks when enabled: the selected key ID and
; its secret from the integration credential source; generate independently for new wiring.
INTEGRATION_WEBHOOK_SECRET_KEY_ID=
INTEGRATION_WEBHOOK_SECRET_KEY=
