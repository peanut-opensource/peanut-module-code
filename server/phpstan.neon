includes:
    - phpstan-tenant-baseline.neon

parameters:
    customRulesetUsed: true
    paths:
        - app/modules
        - app/adminapi
        - app/api
    reportUnmatchedIgnoredErrors: false

services:
    -
        class: PeanutAdmin\PHPStan\Rules\TenantRawQueryRule
        tags:
            - phpstan.rules.rule
