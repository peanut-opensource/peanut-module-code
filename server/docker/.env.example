# Copy to server/docker/.env with mode 0600, or use scripts/configure-runtime.py
# with a private request. See docs/public/installation.md for database selection.
# From the APP root: server/docker/scripts/start.sh -p <instance-project>
# For an existing DB, follow configure-runtime.py's returned override/start command.
# Instance Compose namespace; use a unique name. A CLI -p takes precedence.
COMPOSE_PROJECT_NAME=peanut-app
# Required, an already prepared immutable PHP image ID or digest reference.
PHP_IMAGE=replace-with-prepared-php-image-id
# Required, an already available matching immutable Nginx image reference.
NGINX_IMAGE=nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
# Required by start.sh for bundled MySQL only; immutable image reference.
MYSQL_IMAGE=mysql:8.4.11@sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb
# Bundled MySQL only. Supply its original root password for existing data.
# For a separately authorized fresh instance, generate an independent value (openssl rand -hex 32).
MYSQL_ROOT_PASSWORD=
# Optional published HTTP listener, with its loopback defaults.
HTTP_BIND=127.0.0.1
HTTP_PORT=21080
# Optional loopback MySQL host port, consumed only by compose.local.yaml.
MYSQL_HOST_PORT=21306
# Optional MySQL timezone; defaults to Asia/Shanghai.
TZ=Asia/Shanghai
