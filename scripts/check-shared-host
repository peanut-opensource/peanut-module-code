#!/usr/bin/env python3
"""Check the opt-in Scaffold and Official Modules host files from source."""
import argparse
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def read_source(root, path):
    file = root / path
    if not file.is_file() or file.is_symlink() or not file.resolve().is_relative_to(root):
        raise OSError("missing or not a regular checkout file")
    return file.read_bytes()


def compare(differences, left_root, left_path, right_root, right_path, right_label):
    try:
        left = read_source(left_root, left_path)
    except OSError as error:
        differences.append(f"{left_path}: Scaffold: {error}")
        return

    try:
        right = read_source(right_root, right_path)
    except OSError as error:
        differences.append(f"{left_path}: {right_label} {right_path}: {error}")
        return

    if left != right:
        differences.append(f"{left_path}: differs from {right_label} {right_path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--scaffold-root", type=Path, default=ROOT.parent / "peanut-admin-code")
    parser.add_argument("--module-root", type=Path, default=ROOT.parent / "peanut-module-code")
    args = parser.parse_args()

    scaffold = args.scaffold_root.resolve()
    modules = args.module_root.resolve()
    if scaffold == modules:
        parser.error("Checkout roots must be distinct")

    try:
        registry = (scaffold / "scripts/shared-host-files.txt").read_text(encoding="utf-8")
    except OSError as error:
        parser.error(str(error))
    paths = sorted({line.strip() for line in registry.splitlines()
                    if line.strip() and not line.lstrip().startswith("#")})
    if not paths:
        parser.error("No shared host paths registered")

    differences = []
    for name in paths:
        path = Path(name)
        if path.is_absolute() or ".." in path.parts:
            parser.error(f"Invalid shared path: {name}")
        compare(differences, scaffold, path, modules, path, "Module")

    if differences:
        print("\n".join(differences))
        return 1
    print(f"SHARED-HOST-CHECK passed: {len(paths)} registered files match")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
