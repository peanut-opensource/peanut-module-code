#!/usr/bin/env python3
"""Audit immutable module identities, publish CI originals, and read back GitHub digests."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
from urllib.parse import quote

PRODUCER = runpy.run_path(str(Path(__file__).with_name("build-module-release-index")))
REPO = PRODUCER["REPO"]
INDEX = "module-release-index.json"
API = f"repos/{REPO}"
CATALOG = PRODUCER['CATALOG']
STORE = CATALOG['ReleaseStore'](lambda *arguments: gh(*arguments))
artifact_tag = CATALOG['artifact_tag']
module_identity = CATALOG['module_identity']


def gh(*arguments):
    result = subprocess.run(["gh", *arguments], capture_output=True, check=False)
    if result.returncode:
        raise RuntimeError(f"MODULE_RELEASE_GITHUB_FAILED ({result.returncode}): "
                           + result.stderr.decode("utf8", errors="replace")[-1500:])
    return result.stdout


def api(path):
    return json.loads(gh("api", path))


def pages(path):
    yield from STORE.pages(path)


def index_read(data, tag):
    return CATALOG['read_index'](data, tag)


def asset_read(release, asset):
    name = asset["name"]
    public_url = f"https://github.com/{REPO}/releases/download/{quote(release['tag_name'], safe='')}/{quote(name, safe='')}"
    # GitHub assigns draft assets an untagged-* URL until the release is published.
    # Draft is already pinned by REST ID, tag, CI source and immutable archive digests;
    # do not weaken the final published URL identity check.
    draft_url = re.fullmatch(
        rf"https://github\.com/{re.escape(REPO)}/releases/download/untagged-[a-f0-9]+/{re.escape(quote(name, safe=''))}",
        asset.get("browser_download_url") or "",
    )
    url_valid = bool(draft_url) if release.get("draft") is True else asset.get("browser_download_url") == public_url
    if (not url_valid or asset.get("state") != "uploaded"
            or asset.get("url") != f"https://api.github.com/{API}/releases/assets/{asset['id']}"
            or not re.fullmatch(r"sha256:[0-9a-f]{64}", asset.get("digest") or "")):
        raise RuntimeError("MODULE_RELEASE_ASSET_IDENTITY_INVALID: " + name)
    data = gh("api", f"{API}/releases/assets/{asset['id']}", "-H", "Accept: application/octet-stream")
    if asset["digest"] != "sha256:" + hashlib.sha256(data).hexdigest() or len(data) != asset["size"]:
        raise RuntimeError("MODULE_RELEASE_API_DIGEST_MISMATCH: " + name)
    return data


def local_catalog(directory):
    data = (directory / INDEX).read_bytes()
    index = index_read(data, json.loads(data)["tag"])
    files = {INDEX: data}
    for row in index["modules"]:
        if artifact_tag(index, row) != index['tag']:
            STORE.reference(index, row)
            continue
        path = directory / row["asset"]
        if path.is_symlink() or not path.is_file():
            raise RuntimeError('MODULE_RELEASE_LOCAL_ARTIFACT_INVALID: ' + row['key'])
        data = path.read_bytes()
        if row["sha256"] != hashlib.sha256(data).hexdigest() or row["bytes"] != len(data):
            raise RuntimeError("MODULE_RELEASE_LOCAL_DIGEST_MISMATCH: " + row["key"])
        manifest = PRODUCER["archive_check"](path, "server/app/modules/peanut/" + row["key"][7:].replace("-", "_"))
        if any(manifest.get(field) != row[field] for field in ("key", "version", "license", "kernel_constraint", "dependencies")):
            raise RuntimeError("MODULE_RELEASE_INDEX_MANIFEST_MISMATCH: " + row["key"])
        files[row["asset"]] = data
    return index, files


def history_check(index, resume_draft=False):
    current = {(row["key"], row["version"]): row for row in index["modules"]}
    existing_draft = None
    for release in pages(f"{API}/releases"):
        if release["tag_name"] == index["tag"]:
            if not resume_draft or existing_draft is not None:
                raise RuntimeError("MODULE_RELEASE_TAG_ALREADY_EXISTS: " + index["tag"])
            existing_draft = api(f"{API}/releases/{release['id']}")
            continue
        assets = list(pages(f"{API}/releases/{release['id']}/assets"))
        matches = [a for a in assets if a["name"] == INDEX]
        if len(matches) != 1:
            raise RuntimeError("MODULE_RELEASE_HISTORY_INDEX_MISSING: " + release["tag_name"])
        previous = index_read(asset_read(release, matches[0]), release["tag_name"])
        for row in previous["modules"]:
            if artifact_tag(previous, row) != previous['tag']:
                origin = STORE.reference(previous, row)
                prior_assets = [STORE.asset(origin, row['asset'])]
            else:
                prior_assets = [a for a in assets if a["name"] == row["asset"]]
            if (len(prior_assets) != 1 or prior_assets[0].get("digest") != "sha256:" + row["sha256"]
                    or prior_assets[0].get("size") != row["bytes"]):
                raise RuntimeError("MODULE_RELEASE_HISTORY_ASSET_INVALID")
            candidate = current.get((row["key"], row["version"]))
            if candidate is not None and module_identity(candidate) != module_identity(row):
                raise RuntimeError("MODULE_RELEASE_VERSION_IMMUTABLE: " + row["key"] + "@" + row["version"])
    return existing_draft


def verify_remote(release, index, files, draft):
    if (release.get("draft") is not draft or release.get("prerelease") != ("-rc." in index["tag"])
            or release.get("tag_name") != index["tag"]
            or (not draft and (release.get("immutable") is not True or not release.get("published_at")))):
        raise RuntimeError("MODULE_RELEASE_PUBLICATION_STATE_INVALID")
    assets = list(pages(f"{API}/releases/{release['id']}/assets"))
    if len(assets) != len(files) or {a["name"] for a in assets} != set(files):
        raise RuntimeError("MODULE_RELEASE_ASSET_SET_INVALID")
    for asset in assets:
        if asset_read(release, asset) != files[asset["name"]]:
            raise RuntimeError("MODULE_RELEASE_READBACK_MISMATCH: " + asset["name"])
    for row in index['modules']:
        if artifact_tag(index, row) != index['tag']:
            STORE.reference(index, row)


def verify_partial_draft(release, files):
    """Resume uploads by exact original bytes, never --clobber or a new draft."""
    if release.get('draft') is not True:
        raise RuntimeError('MODULE_RELEASE_NOT_A_DRAFT')
    assets = list(pages(f"{API}/releases/{release['id']}/assets"))
    names = [asset['name'] for asset in assets]
    if len(names) != len(set(names)) or set(names) - set(files):
        raise RuntimeError('MODULE_RELEASE_DRAFT_UNKNOWN_ASSET')
    for asset in assets:
        if asset_read(release, asset) != files[asset['name']]:
            raise RuntimeError('MODULE_RELEASE_DRAFT_BYTES_CHANGED: ' + asset['name'])
    return sorted(set(files) - set(names))


def verify_main_source(source):
    """A protected PR merge M can publish the already-qualified source S."""
    git = lambda *args: subprocess.check_output(['git', *args], text=True).strip()
    if git('remote', 'get-url', 'origin') not in (f'https://github.com/{REPO}', f'https://github.com/{REPO}.git', f'git@github.com:{REPO}.git'):
        raise RuntimeError('MODULE_RELEASE_ORIGIN_INVALID')
    main = api(f'{API}/commits/main')['sha']
    if git('rev-parse', 'HEAD') != main or os.environ.get('GITHUB_SHA') != main:
        raise RuntimeError('MODULE_RELEASE_MAIN_MOVED')
    if main == source:
        return main
    prs = api(f'{API}/commits/{source}/pulls')
    matches = [pr for pr in prs if pr.get('head', {}).get('sha') == source and pr.get('merge_commit_sha')]
    if len(matches) != 1:
        raise RuntimeError('MODULE_RELEASE_MERGED_SOURCE_PR_REQUIRED')
    pr = api(f"{API}/pulls/{matches[0]['number']}")
    merge = pr.get('merge_commit_sha')
    if (pr.get('merged') is not True or pr.get('state') != 'closed'
            or pr.get('head', {}).get('sha') != source or pr.get('head', {}).get('ref') != 'dev'
            or pr.get('base', {}).get('ref') != 'main'
            or pr.get('head', {}).get('repo', {}).get('full_name') != REPO
            or pr.get('base', {}).get('repo', {}).get('full_name') != REPO
            or not isinstance(merge, str) or not re.fullmatch(r'[a-f0-9]{40}', merge)):
        raise RuntimeError('MODULE_RELEASE_MERGED_SOURCE_PR_INVALID')
    parents = git('show', '-s', '--format=%P', merge).split()
    if len(parents) != 2 or parents[1] != source or git('rev-parse', merge + '^{tree}') != git('rev-parse', source + '^{tree}'):
        raise RuntimeError('MODULE_RELEASE_MERGE_SOURCE_TREE_MISMATCH')
    git('merge-base', '--is-ancestor', merge, main)
    return main


def ensure_source_tag(index, main):
    tag, source = index['tag'], index['commit']
    git = lambda *args: subprocess.check_output(['git', *args], text=True).strip()
    live = git('ls-remote', 'origin', 'refs/tags/' + tag)
    if not live:
        created = json.loads(gh('api', '--method', 'POST', f'{API}/git/tags', '-f', 'tag=' + tag,
                                '-f', 'message=Qualified official Module catalog ' + tag + ' source ' + source,
                                '-f', 'object=' + source, '-f', 'type=commit'))
        if not re.fullmatch(r'[a-f0-9]{40}', created.get('sha', '')):
            raise RuntimeError('MODULE_RELEASE_TAG_OBJECT_INVALID')
        if api(f'{API}/commits/main')['sha'] != main:
            raise RuntimeError('MODULE_RELEASE_MAIN_MOVED')
        gh('api', '--method', 'POST', f'{API}/git/refs', '-f', 'ref=refs/tags/' + tag, '-f', 'sha=' + created['sha'])
    remote = api(f"{API}/git/ref/tags/{quote(tag, safe='')}")['object']
    if remote.get('type') != 'tag':
        raise RuntimeError('MODULE_RELEASE_ANNOTATED_TAG_REQUIRED')
    annotated = api(f"{API}/git/tags/{remote['sha']}")
    if (annotated.get('tag') != tag or annotated.get('object', {}).get('type') != 'commit'
            or annotated.get('object', {}).get('sha') != source):
        raise RuntimeError('MODULE_RELEASE_TAG_SOURCE_MISMATCH')
    git('fetch', '--no-tags', 'origin', f'refs/tags/{tag}:refs/tags/{tag}')
    if git('rev-parse', tag + '^{commit}') != source or api(f'{API}/commits/main')['sha'] != main:
        raise RuntimeError('MODULE_RELEASE_PUBLICATION_REFS_CHANGED')
    return remote['sha']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--directory", type=Path, required=True)
    parser.add_argument("--mode", choices=["audit", "publish", "verify"], required=True)
    parser.add_argument("--run-id", type=int)
    args = parser.parse_args()
    directory = args.directory.resolve(strict=True)
    index, files = local_catalog(directory)
    if args.mode == "verify":
        release = api(f"{API}/releases/tags/{quote(index['tag'], safe='')}")
        verify_remote(release, index, files, False)
        print(f"PUBLIC_RELEASE_VERIFIED {index['tag']} assets={len(files)} commit={index['commit']}")
        return
    existing_draft = history_check(index, resume_draft=args.mode == "publish")
    if args.mode == "audit":
        print(f"RELEASE_HISTORY_AUDITED {index['tag']} modules={len(index['modules'])}")
        return
    # Publishing consumes the successful build's originals; it never packs again.
    if (os.environ.get('GITHUB_ACTIONS') != 'true' or os.environ.get('GITHUB_EVENT_NAME') != 'workflow_dispatch'
            or os.environ.get("GITHUB_REPOSITORY") != REPO or os.environ.get("GITHUB_REF") != "refs/heads/main" or not args.run_id
            or os.environ.get("MODULE_RELEASE_IMMUTABLE") != "true"):
        raise RuntimeError("MODULE_RELEASE_PUBLISH_GATE_REQUIRED")
    run = api(f"{API}/actions/runs/{args.run_id}")
    receipt = json.loads((directory / "build-receipt.json").read_bytes())
    built = sorted(row['key'] for row in index['modules'] if artifact_tag(index, row) == index['tag'])
    reused = sorted(row['key'] for row in index['modules'] if artifact_tag(index, row) != index['tag'])
    if (run.get('status') != 'completed' or run.get("conclusion") != "success" or run.get("event") != "workflow_dispatch"
            or run.get("path") != ".github/workflows/module-release.yml"
            or run.get("head_sha") != index["commit"] or run.get("repository", {}).get("full_name") != REPO
            or receipt.get('run_id') != args.run_id or receipt.get('commit') != index['commit']
            or receipt.get('tag') != index['tag'] or receipt.get('index_sha256') != hashlib.sha256(files[INDEX]).hexdigest()
            or receipt.get('built_modules') != built or receipt.get('reused_modules') != reused
            or not re.fullmatch(r'[a-f0-9]{64}', receipt.get('plan_sha256', ''))):
        raise RuntimeError("MODULE_RELEASE_CI_ORIGINALS_REQUIRED")
    main = verify_main_source(index['commit'])
    ensure_source_tag(index, main)
    if existing_draft is not None and existing_draft.get('draft') is False:
        verify_remote(existing_draft, index, files, False)
        print(f"PUBLIC_RELEASE_ALREADY_VERIFIED {index['tag']} assets={len(files)} commit={index['commit']}")
        return
    flags = ["--prerelease"] if "-rc." in index["tag"] else []
    if existing_draft is None:
        gh("release", "create", index["tag"], "--repo", REPO, "--verify-tag", "--draft", *flags,
           "--title", "Official modules " + index["tag"], "--notes",
           f"Fixed source {index['commit']}; native check/pack CI run {args.run_id}. "
           "Module versions are independent. Unchanged archives reference their immutable original release. "
           "This release does not assert business E2E qualification.")
        # GET releases/tags/{tag} returns 404 for drafts. Resolve the real release ID.
        same_tag = [r for r in pages(f"{API}/releases") if r.get("tag_name") == index["tag"]]
        if len(same_tag) != 1 or same_tag[0].get("draft") is not True:
            raise RuntimeError("MODULE_RELEASE_DRAFT_ID_UNAVAILABLE")
        release = api(f"{API}/releases/{same_tag[0]['id']}")
    else:
        # Missing uploads are resumed only after checking every already-visible byte.
        release = existing_draft
    missing = verify_partial_draft(release, files)
    if missing:
        gh('release', 'upload', index['tag'], '--repo', REPO, *[str(directory / name) for name in missing])
    # A failure leaves the exact draft/run handle; never delete, clobber or repackage.
    verify_remote(release, index, files, True)
    if verify_main_source(index['commit']) != main:
        raise RuntimeError('MODULE_RELEASE_MAIN_MOVED')
    gh("api", "--method", "PATCH", f"{API}/releases/{release['id']}",
       "-F", "draft=false", "-F", f"prerelease={'true' if flags else 'false'}")
    release = api(f"{API}/releases/{release['id']}")
    verify_remote(release, index, files, False)
    print(f"PUBLIC_RELEASE_VERIFIED {index['tag']} assets={len(files)} commit={index['commit']}")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"MODULE_RELEASE_PUBLISH_FAILED: {exc}", file=sys.stderr)
        raise SystemExit(1)
