# For the registered remote development MySQL service host only.
# Copy to a private file with mode 0600 on that host. Supply the existing service's credentials
# from its registered credential source. For a separately authorized new service, use independently
# generated passwords (for example openssl rand -hex 32); preserve the existing values on restarts.
# Required initial schema, application user, application password and MySQL root password.
DB_NAME=
DB_USER=
DB_PASS=
MYSQL_ROOT_PASSWORD=
# On the registered host, validate the declaration with:
# docker compose --env-file /path/to/private.env -f deploy/docker-compose.remote-development.yml config --quiet
