{
    "name": "peanut-module-code-platform",
    "version": "1.0.0",
    "private": true,
    "description": "Peanut Module Code instance platform control plane",
    "author": "application owner",
    "license": "Apache-2.0",
    "homepage": "https://github.com/peanut-business/peanut-admin-code",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/peanut-business/peanut-admin-code.git",
        "directory": "platform"
    },
    "scripts": {
        "dev": "vite --configLoader runner",
        "build": "vue-tsc --noEmit && vite build --configLoader runner",
        "type:check": "vue-tsc --noEmit",
        "type:check:governance": "node scripts/check-governance-types.mjs",
        "type:check:governance-tests": "node ../tools/quality/node_modules/typescript/bin/tsc --noEmit --project tsconfig.governance-tests.json",
        "test:governance": "node ../tools/quality/node_modules/vitest/vitest.mjs run --config vitest.governance.config.mjs"
    },
    "dependencies": {
        "@element-plus/icons-vue": "2.3.2",
        "@peanut-admin/ui-vue": "5.0.5",
        "@peanut-admin/vue": "5.0.5",
        "axios": "0.34.0",
        "element-plus": "2.14.3",
        "openapi-fetch": "0.17.0",
        "pinia": "2.0.23",
        "vue": "3.5.41",
        "vue-router": "4.0.14"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "5.2.4",
        "typescript": "^4.8.4",
        "vite": "6.4.3",
        "vue-tsc": "^1.0.14"
    },
    "workspaces": [
        "src/modules/peanut-ops"
    ]
}
