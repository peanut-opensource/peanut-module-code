# Copy to server/docker/.env.source-collaboration. This file has no secrets.
# Required Compose project name for the source-only ingress; use your registered name.
SOURCE_COLLABORATION_PROJECT=peanut-source-collaboration
# Required port of the registered host PHP listener that Docker can reach.
SOURCE_PHP_PORT=20180
# From the APP root, the second file supplements the generated, private collaboration.env.
# docker compose --env-file server/docker/collaboration.env --env-file server/docker/.env.source-collaboration -f deploy/docker-compose.source-collaboration.yml config --quiet
