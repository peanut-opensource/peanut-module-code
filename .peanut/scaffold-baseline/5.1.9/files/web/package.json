{
    "name": "peanut-module-code-web",
    "description": "Peanut Module Code management client",
    "version": "1.0.0",
    "private": true,
    "author": "application owner",
    "license": "Apache-2.0",
    "homepage": "https://github.com/peanut-business/peanut-admin-code",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/peanut-business/peanut-admin-code.git",
        "directory": "web"
    },
    "scripts": {
        "dev": "vite --configLoader runner",
        "build": "node ../scripts/sync-brand-assets.mjs && vue-tsc --noEmit && vite build --configLoader runner",
        "report": "REPORT=true npm run build",
        "preview": "npm run build && vite preview --host",
        "type:check": "node ../scripts/sync-brand-assets.mjs && vue-tsc --noEmit --skipLibCheck",
        "lint-staged": "npx lint-staged",
        "hooks:install": "husky install"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.vue": [
            "stylelint --fix",
            "prettier --write",
            "eslint --fix"
        ],
        "*.{less,css}": [
            "stylelint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@element-plus/icons-vue": "2.3.2",
        "@peanut-admin/ui-vue": "5.1.0",
        "@peanut-admin/vue": "5.1.0",
        "@vueuse/core": "^9.3.0",
        "axios": "0.34.0",
        "dayjs": "^1.11.5",
        "dompurify": "^3.4.17",
        "element-plus": "2.14.3",
        "lodash": "^4.17.21",
        "mitt": "^3.0.0",
        "nprogress": "^0.2.0",
        "openapi-fetch": "0.17.0",
        "pinia": "^2.0.23",
        "query-string": "^8.0.3",
        "sortablejs": "^1.15.0",
        "vue": "^3.3.0",
        "vue-i18n": "^9.2.2",
        "vue-router": "^4.0.14",
        "@peanut-admin/client": "5.1.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^17.1.2",
        "@commitlint/config-conventional": "^17.1.0",
        "@types/lodash": "^4.14.186",
        "@types/nprogress": "^0.2.0",
        "@types/sortablejs": "^1.15.0",
        "@typescript-eslint/eslint-plugin": "^5.40.0",
        "@typescript-eslint/parser": "^5.40.0",
        "@vitejs/plugin-vue": "5.2.4",
        "@vitejs/plugin-vue-jsx": "4.2.0",
        "@vue/babel-plugin-jsx": "^1.1.1",
        "consola": "^2.15.3",
        "cross-env": "^7.0.3",
        "eslint": "^8.25.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-import-resolver-typescript": "^3.5.1",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-vue": "^9.6.0",
        "husky": "^8.0.1",
        "less": "^4.1.3",
        "lint-staged": "^13.0.3",
        "openapi-typescript": "7.13.0",
        "postcss-html": "^1.5.0",
        "postcss-less": "6.0.0",
        "prettier": "^2.7.1",
        "rollup": "^4.44.0",
        "rollup-plugin-visualizer": "^5.8.2",
        "stylelint": "^14.13.0",
        "stylelint-config-prettier": "^9.0.3",
        "stylelint-config-recommended": "9.0.0",
        "stylelint-config-recommended-vue": "^1.4.0",
        "stylelint-config-standard": "^29.0.0",
        "stylelint-order": "^5.0.0",
        "typescript": "5.9.3",
        "vite": "6.4.3",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-eslint": "^1.8.1",
        "vite-svg-loader": "^3.6.0",
        "vue-tsc": "3.2.5"
    },
    "engines": {
        "node": ">=22.12.0 <23"
    },
    "resolutions": {
        "bin-wrapper": "npm:bin-wrapper-china",
        "gifsicle": "5.2.0"
    },
    "pnpm": {
        "overrides": {
            "decode-uri-component": "0.5.0",
            "js-yaml@4.3.1": "4.3.2",
            "postcss": "8.5.23",
            "micromatch@<4.0.8": "4.0.8",
            "yaml@>=2.0.0 <2.8.3": "2.8.3",
            "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
            "brace-expansion@<1.1.21": "1.1.21",
            "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
            "brace-expansion@<1.1.20": "1.1.21",
            "brace-expansion@>=2.0.0 <2.1.6": "2.1.7",
            "brace-expansion@<1.1.19": "1.1.21",
            "brace-expansion@>=2.0.0 <2.1.5": "2.1.7",
            "probe-image-size@<=7.3.0": "7.4.0"
        }
    },
    "packageManager": "pnpm@9.15.6"
}
