# Optional source-root Compose overrides. Copy to .env only when overrides are wanted.
# The mounted application uses server/docker/.env as its main Compose input.
# Later --env-file values override earlier ones. Use inspected immutable image IDs.
# docker compose --env-file server/docker/.env --env-file .env -f compose.yaml config --quiet
# HTTP_BIND=127.0.0.1
# HTTP_PORT=21080
# PHP_IMAGE=replace-with-prepared-php-image-id
# NGINX_IMAGE=replace-with-prepared-nginx-image-id
