{
    "name": "peanut-business/peanut-module-code",
    "description": "Peanut Module Code application backend",
    "type": "project",
    "keywords": [
        "admin",
        "scaffold",
        "thinkphp",
        "vue"
    ],
    "homepage": "https://github.com/peanut-business/peanut-admin-code",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "application owner"
        }
    ],
    "provide": {
        "peanut-admin/module-composition-host": "1.0.0"
    },
    "require": {
        "php": "^8.3",
        "topthink/framework": "^8.0",
        "topthink/think-multi-app": "^1.1.1",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "firebase/php-jwt": "^7.1",
        "dragonmantank/cron-expression": "^3.3",
        "qiniu/php-sdk": "^7.4",
        "aws/aws-sdk-php": "^3.0",
        "aliyuncs/oss-sdk-php": "^2.4",
        "qcloud/cos-sdk-v5": "^2.5",
        "peanut-admin/core": "5.1.3-rc.20261120",
        "symfony/html-sanitizer": "^7.3",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.6",
        "topthink/think-migration": "3.1.1"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "exclude-from-classmap": [
            "app/modules/*/*/database/migrations/",
            "app/modules/*/*/*/database/migrations/"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php docker/scripts/prepare-vendor.php"
        ]
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "peanut-admin/core",
                "description": "Peanut Admin technical kernel and ThinkPHP integration",
                "type": "library",
                "license": "Apache-2.0",
                "support": {
                    "source": "https://github.com/peanut-business/peanut-admin-core-php"
                },
                "require": {
                    "composer/semver": "^3.4.4",
                    "ext-fileinfo": "*",
                    "ext-json": "*",
                    "ext-openssl": "*",
                    "ext-pdo": "*",
                    "ext-sodium": "*",
                    "opis/json-schema": "^2.6.0",
                    "php": "^8.3",
                    "topthink/think-orm": "^4.0.51"
                },
                "suggest": {
                    "aliyuncs/oss-sdk-php": "Required by hosts that construct AliyunStorageDriver.",
                    "qcloud/cos-sdk-v5": "Required by hosts that construct QcloudStorageDriver.",
                    "qiniu/php-sdk": "Required by hosts that construct QiniuStorageDriver."
                },
                "autoload": {
                    "psr-4": {
                        "PeanutAdmin\\DataPermission\\": "data-permission/src/",
                        "PeanutAdmin\\FileMedia\\": "file-media/src/",
                        "PeanutAdmin\\IntegrationSecurity\\": "integration-security/src/",
                        "PeanutAdmin\\Kernel\\": "kernel/src/",
                        "PeanutAdmin\\Settings\\": "settings/src/"
                    }
                },
                "scripts": {
                    "analyse": "phpstan analyse --no-progress",
                    "test": "phpunit --no-configuration --bootstrap vendor/autoload.php --fail-on-empty-test-suite --fail-on-risky data-permission/tests file-media/tests integration-security/tests kernel/tests settings/tests testing/tests"
                },
                "version": "5.1.3-rc.20261120",
                "source": {
                    "type": "git",
                    "url": "https://github.com/peanut-business/peanut-admin-core-php.git",
                    "reference": "4b2024b0bf030086ef8e6693aacafcea504a65ee"
                },
                "dist": {
                    "type": "zip",
                    "url": "../packages/core-php/peanut-admin-core-5.1.3-rc.20261120.zip",
                    "reference": "4b2024b0bf030086ef8e6693aacafcea504a65ee",
                    "shasum": "734b2f7626873d545487804a312ea0d5ff1727e0"
                }
            }
        }
    ]
}
